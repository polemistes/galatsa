{
  // Shared settings for building a package to dist/ with tsc. A package's
  // tsconfig.build.json extends this and sets "rootDir", "outDir" and "include"
  // (paths in an extended file are relative to that file, so they cannot live here).
  //
  // The "@galatsa/source" condition is turned off, so a package that imports another
  // workspace package compiles against that package's dist/ output instead of pulling
  // its source into this build. `pnpm build` runs the builds in dependency order.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "customConditions": [],
    "noEmit": false
  }
}
