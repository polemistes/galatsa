{
  "name": "@galatsa/bench",
  "version": "0.0.0",
  "private": true,
  "description": "Performance benchmark for Galatsa rendering engines: a fixed scene, a fixed camera run and a frame-time meter",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "@galatsa/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./harness": {
      "@galatsa/source": "./src/harness/harness.ts",
      "types": "./dist/harness/harness.d.ts",
      "default": "./dist/harness/harness.js"
    }
  },
  "scripts": {
    "start": "node --conditions=@galatsa/source src/main.ts",
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@galatsa/core": "workspace:*",
    "@galatsa/extension-api": "workspace:*",
    "@galatsa/format": "workspace:*",
    "@galatsa/renderer": "workspace:*",
    "@galatsa/storage": "workspace:*",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
