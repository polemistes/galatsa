{
  // The bench is run by Node from source (see the "start" script), so it has Node
  // types. Measurements that run in a browser can add "DOM" to "lib" later.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.mts", "src/**/*.cts"]
}
