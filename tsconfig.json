{
  // Type-checks every source file in the repository in one program, so that code
  // in any folder is checked. Node types and the DOM library are added here, for
  // scripts, tests and configs. Each workspace package also has its own
  // "typecheck" script with its own environment (see tsconfig.base.json).
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "types": ["node"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  // tsc does not expand braces in "include", so each extension is listed.
  "include": [
    "*.ts",
    "*.tsx",
    "*.mts",
    "*.cts",
    "*.mjs",
    "packages/**/src/**/*.ts",
    "packages/**/src/**/*.tsx",
    "packages/**/src/**/*.mts",
    "packages/**/src/**/*.cts",
    "apps/**/src/**/*.ts",
    "apps/**/src/**/*.tsx",
    "apps/**/src/**/*.mts",
    "apps/**/src/**/*.cts",
    "bench/**/*.ts",
    "bench/**/*.tsx",
    "bench/**/*.mts",
    "bench/**/*.cts",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "tests/**/*.mts",
    "tests/**/*.cts",
    "scripts/**/*.ts",
    "scripts/**/*.tsx",
    "scripts/**/*.mts",
    "scripts/**/*.cts"
  ],
  "exclude": ["**/node_modules", "**/dist", "**/coverage", ".claude"]
}
