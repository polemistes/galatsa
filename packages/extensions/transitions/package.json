{
  "name": "@galatsa/extension-transitions",
  "version": "0.0.0",
  "private": true,
  "description": "Built-in camera transitions (a smooth and efficient flight, a cross-fade and a cut) and the motion comfort settings that govern them",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@galatsa/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "vitest": "catalog:"
  },
  "dependencies": {
    "@galatsa/core": "workspace:*",
    "@galatsa/extension-api": "workspace:*",
    "@galatsa/i18n": "workspace:*"
  }
}
