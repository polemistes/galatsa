{
  "name": "@galatsa/extension-text",
  "version": "0.0.0",
  "private": true,
  "description": "Built-in text extension: text boxes of shared rich text, laid out by the renderer and edited in place, with font, size, colour, bold, italic, alignment and lists",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@galatsa/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./view": {
      "@galatsa/source": "./src/view.ts",
      "types": "./dist/view.d.ts",
      "default": "./dist/view.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "vitest": "catalog:"
  },
  "dependencies": {
    "@galatsa/core": "workspace:*",
    "@galatsa/extension-api": "workspace:*",
    "@galatsa/i18n": "workspace:*",
    "yjs": "13.6.33"
  }
}
