{
  "name": "@galatsa/core",
  "version": "0.0.0",
  "private": true,
  "description": "Document model, camera, routes, commands and extension registry for Galatsa",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@galatsa/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ydoc": {
      "@galatsa/source": "./src/ydoc/index.ts",
      "types": "./dist/ydoc/index.d.ts",
      "default": "./dist/ydoc/index.js"
    },
    "./testing": {
      "@galatsa/source": "./src/ydoc/testing.ts",
      "types": "./dist/ydoc/testing.d.ts",
      "default": "./dist/ydoc/testing.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "vitest": "catalog:"
  },
  "dependencies": {
    "fractional-indexing": "4.0.0",
    "yjs": "13.6.33"
  }
}
