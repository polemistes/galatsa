{
  "name": "@galatsa/renderer",
  "version": "0.0.0",
  "private": true,
  "description": "Canvas 2D renderer of Galatsa: draws the resolved document through the camera, with culling, image levels, hit testing and region rendering",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@galatsa/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fonts.css": "./src/fonts.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/fonts.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fontsource/noto-sans": "5.3.0",
    "@fontsource/noto-sans-mono": "5.3.0",
    "@fontsource/noto-serif": "5.3.0",
    "@galatsa/core": "workspace:*",
    "@galatsa/extension-api": "workspace:*",
    "@galatsa/i18n": "workspace:*"
  },
  "devDependencies": {
    "vitest": "catalog:"
  }
}
