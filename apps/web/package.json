    "@galatsa/extension-examples": "workspace:*",
    "@galatsa/extension-image": "workspace:*",
    "@galatsa/extension-routes": "workspace:*",
    "@galatsa/extension-shape": "workspace:*",
    "@galatsa/extension-text": "workspace:*",
    "@galatsa/format": "workspace:*",
    "@galatsa/i18n": "workspace:*",
    "@galatsa/renderer": "workspace:*",
    "@galatsa/storage": "workspace:*",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@fontsource/noto-sans": "5.3.0",
    "@fontsource/noto-sans-mono": "5.3.0",
    "@fontsource/noto-serif": "5.3.0",
